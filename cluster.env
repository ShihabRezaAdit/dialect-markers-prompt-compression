# ARCC2 (University of Cincinnati) settings, reused from Idea 112. Read by run_main.sh,
# scripts/setup_envs.sh and slurm/*.sbatch. No secrets here; committed so git pull brings it.

PARTITION="gpu-h200"      # GPU partition (compression and generation); keep one GPU type per model
QOS="proj-606"            # PPMS project 606 (required on every job)
ACCOUNT=""                # ARCC2 does not use Slurm accounts
GPU_GRES="gpu:1"
CPUS_PER_TASK=8
MEM="64G"
TIME_GPU="02:00:00"         # every GPU array task (compression and mechanism shards) is sized to finish well within this
TIME_GPU_SMOKE="00:30:00"   # smoke-run GPU jobs take minutes; a short limit lets Slurm fit them into gaps

CPU_PARTITION="public"    # ARCC2 CPU partition (Idea 112 ran a CPU job there with QOS proj-606)
RENDER_CPUS=4             # internal plan: 64 tasks x 4 CPUs
RENDER_MEM="16G"
TIME_RENDER="08:00:00"

MODULES="python/3.11.11"          # env-compress, env-gen, env-stats
MODULES_render="python/3.10.18"   # value-nlp needs Python 3.10 (internal plan Section 27)
MODULES_sc="python/3.10.18"       # selective-context pins spaCy 3.2.0
PYTHON_BIN="python3"
ENV_ROOT="/N/lustre/project/proj-606/rezamb/envs"      # env-render, env-compress, env-sc, env-gen, env-stats
HF_HOME="/N/lustre/project/proj-606/rezamb/hf_cache"   # shared with Idea 112 (Llama-3.1 and Qwen2.5 may already be cached)
NLP_DATA="/N/lustre/project/proj-606/rezamb/nlp_data"  # NLTK and Stanza data used by value-nlp, llmlingua, selective-context
HF_HUB_OFFLINE=1          # downloads run on the login node; compute nodes read the caches
